cabal-version: 3.4
name:          qxfx0
version:       0.1.0.0
synopsis:      QxFx0 Flagship Philosophical Dialogue Thinking System
description:   Deterministic Russian philosophical dialogue runtime: typed
               CanonicalMoveFamily routing via Semantic.Logic and a guarded
               cascade (intuition thresholds, meaning graph, consciousness),
               GF-constrained surface generation, bounded adaptive learning
               contours, and gate-driven release. Experimental modules
               (game-theory LP, spectral clustering, discrete belief update)
               compile as other-modules for the extended scientific contour.
category:      AI
author:        QxFx Research
maintainer:    QxFx Research <qxfx@research.example>
license:       MIT
extra-doc-files: CHANGELOG.md
data-files:
  migrations/*.sql
  resources/config/*.json
  resources/lexicon/*.json
  resources/morphology/*.json
  semantics/*.nix
  spec/*.agda
  spec/*.tsv
  spec/datalog/*.dl
  spec/gf/*.gf
  spec/gf/*.tsv
  spec/sql/*.sql
  spec/sql/lexicon/*.sql
  scripts/http_runtime.py

source-repository head
  type: git
  location: https://github.com/qxfx/qxfx0

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns
               -Wincomplete-record-updates -Wredundant-constraints
               -Wmissing-deriving-strategies -Wno-unticked-promoted-constructors

common base-deps
  default-language: Haskell2010
  build-depends:
    , base          >=4.17 && <5
    , text          >=1.2 && <2.2
    , bytestring    >=0.11 && <0.13
    , mtl           >=2.2 && <2.4
    , containers    >=0.6 && <0.8
    , aeson         >=1.5 && <2.3
    , unordered-containers >=0.2 && <0.3
    , pgf2          >=1.3 && <1.4

