.gitattributes text eol=lf
# Force LF line endings for shell scripts so they are executable on all platforms.
*.sh text eol=lf
# Force LF for SQL so embedded string comparisons are deterministic across platforms.
*.sql text eol=lf
# Generated artifacts that must match LF source files.
src/QxFx0/Bridge/EmbeddedSQL.hs text eol=lf
resources/morphology/forms_by_surface.json text eol=lf
# M7 pre-registration: byte-stable frozen artifacts (sha256-pinned).
spec/gf/m7_admissible_predicates.tsv text eol=lf
scripts/m7_gate_check.py text eol=lf
# Eval packets are read positionally; CRLF would leak a \r into the last
# column and break expected-family matching.
spec/eval/pilot50_prompts.tsv text eol=lf
spec/eval/pilot50_prompts_harness.tsv text eol=lf
# GF slot-gap frozen row list and its sha256 sidecar: the digest is pinned in
# docs/closure/GF_SLOT_COVERAGE_PREREG_DRAFT_2026-11-01.md, so a CRLF checkout
# would silently invalidate it.
spec/gf/gf_slot_gap_2026-11-06.tsv text eol=lf
spec/gf/gf_slot_gap_2026-11-06.tsv.sha256 text eol=lf
# Known-failure baseline for the 4-point realizability checker: its sha256 is
# quoted in the slot prereg, so a CRLF checkout would invalidate it.
spec/gf/gf_slot_realizability_baseline.tsv text eol=lf
spec/gf/gf_slot_realizability_baseline.tsv.sha256 text eol=lf
# Concept-v3 user-regime probe corpus: its sha256 is pinned in
# docs/closure/USER_REGIME_CAPTURE_PREREG_2026-11-13.md and the driver reads
# columns positionally, so a CRLF checkout would invalidate both.
spec/eval/user_regime_multiturn_2026-11-13.tsv text eol=lf
