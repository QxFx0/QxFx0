packages: .
import: cabal.project.freeze

-- Reproducibility pin (П1, 2026-08-22): solve against the same Hackage
-- snapshot the pre-migration freeze was generated from, so a GHC
-- 9.6.6 -> 9.6.7 move changes only compiler-bound packages (base et al).
index-state: hackage.haskell.org 2026-04-22T17:45:50Z

tests: True

test-show-details: streaming

-- RAM guard for 10 GB hosts: build single-target, cap GHC heap at 8 GB.
jobs: 1

package qxfx0
  ghc-options: +RTS -M8G -RTS

-- NOTE: machine-specific settings (compiler path, GF C-runtime lib/include
-- dirs, link rpath) live in cabal.project.local (gitignored). CI provisions
-- the GF runtime separately; see .github/workflows/ci.yml.
