    ArguedCounterFreedom1Counter = { s = "не любой выбор свободен: выбор под принуждением, страхом или незнанием не делает действие свободным" } ;
    ArguedSynthesisFreedom1Synthesis = { s = "свобода требует осознанности — только выбор, понятый как свой, превращает возможность в свободу" } ;
    ArguedCounterFreedom2Counter = { s = "ответственность не отменяет свободу — она задаёт ей форму, а не отнимает её" } ;
    ArguedSynthesisFreedom2Synthesis = { s = "граница между свободой и произволом проходит через ответственность: произвол игнорирует других, свобода учитывает" } ;
    ArguedCounterTruth1Counter = { s = "доступ к реальности всегда опосредован наблюдателем — и наблюдатель не может выйти за пределы себя" } ;
    ArguedSynthesisTruth1Synthesis = { s = "истина — не обладание, а дисциплина проверки: то, что выдерживает воспроизведение, ближе к истине" } ;
    ArguedCounterTruth2Counter = { s = "воспроизводимость не гарантирует истину — она лишь отсеивает то, что точно ею не является" } ;
    ArguedSynthesisTruth2Synthesis = { s = "наука не доказывает истину — она фальсифицирует ложь" } ;
    ArguedCounterResponsibility1Counter = { s = "осознание последствий не гарантирует правильного выбора — оно лишь исключает неведение как оправдание" } ;
    ArguedSynthesisResponsibility1Synthesis = { s = "ответственность начинается не с действия, а с готовности понимать, к чему действие ведёт" } ;
    ArguedCounterResponsibility2Counter = { s = "обязательства перед другими не должны уничтожать обязательства перед собой" } ;
    ArguedSynthesisResponsibility2Synthesis = { s = "зрелая ответственность — это баланс, а не жертва" } ;
    ArguedCounterFear1Counter = { s = "не любая угроза реальна: страх может быть вызван воображением, памятью или чужим рассказом — и тогда он сигнализирует не о мире, а о нас" } ;
    ArguedSynthesisFear1Synthesis = { s = "страх требует различения: сигнал — не приговор, а повод для проверки" } ;
    ArguedCounterFear2Counter = { s = "страх может указывать и на то, что мы не готовы отпустить — даже если это уже не служит" } ;
    ArguedSynthesisFear2Synthesis = { s = "страх полезен не ответом, а вопросом: что именно поставлено на кон?" } ;
    ArguedCounterFaith1Counter = { s = "принятие без доказательств не означает принятия вопреки доказательствам — вера, игнорирующая факты, перестаёт быть верой и становится самообманом" } ;
    ArguedSynthesisFaith1Synthesis = { s = "вера — не замена знанию, а решение действовать в условиях неполноты" } ;
    ArguedCounterFaith2Counter = { s = "вера без сомнения — догма; доверие без проверки — наивность" } ;
    ArguedSynthesisFaith2Synthesis = { s = "живая вера включает сомнение, а не отрицает его" } ;
    ArguedCounterConsciousness1Counter = { s = "перспектива от первого лица не гарантирует достоверности — она гарантирует только неотменимость переживания" } ;
    ArguedSynthesisConsciousness1Synthesis = { s = "сознание — не окно в реальность, а условие, при котором реальность вообще может быть увидена" } ;
    ArguedCounterConsciousness2Counter = { s = "самоотчёт не исчерпывает сознания — многое из того, что мы переживаем, мы не можем выразить словами" } ;
    ArguedSynthesisConsciousness2Synthesis = { s = "сознание шире языка, но язык — единственный доступный нам инструмент его исследования" } ;
    ArguedCounterMemory1Counter = { s = "память не хранит прошлое нейтрально — она переписывает его при каждом обращении, подстраивая под настоящее" } ;
    ArguedSynthesisMemory1Synthesis = { s = "память — не архив, а непрерывный процесс осмысления: мы помним не то, что было, а то, что значит для нас сейчас" } ;
    ArguedCounterMemory2Counter = { s = "избирательность памяти — не только ограничение; это же — условие осмысленности: без фильтра мы бы тонули в деталях" } ;
    ArguedSynthesisMemory2Synthesis = { s = "надёжность памяти — не в точности, а в устойчивости: то, что помнится несмотря на искажения, — важно" } ;
    ArguedCounterWillfulness1Counter = { s = "отрицание критериев не освобождает от последствий — оно лишь делает их непредсказуемыми" } ;
    ArguedSynthesisWillfulness1Synthesis = { s = "произвол — не свобода без правил, а отказ от самой идеи правила" } ;
    ArguedCounterOpinion1Counter = { s = "субъективность мнения не означает его ложности — она означает его ограниченность перспективой" } ;
    ArguedSynthesisOpinion1Synthesis = { s = "ценность мнения не в безличной истине, а в том, чью позицию оно раскрывает" } ;
    ArguedCounterRemembrance1Counter = { s = "реконструкция неизбежно привносит настоящее — мы вспоминаем не то, что пережили, а то, кем стали после пережитого" } ;
    ArguedSynthesisRemembrance1Synthesis = { s = "два человека, пережившие одно событие, помнят его по-разному — и оба правдивы в своей памяти" } ;
    ArguedCounterSelfConsciousness1Counter = { s = "взгляд на себя со стороны неизбежно искажает — мы видим не себя, а свою проекцию себя" } ;
    ArguedSynthesisSelfConsciousness1Synthesis = { s = "самосознание — не знание о себе, а непрерывный процесс само-вопрошания" } ;
    ArguedCounterBeauty1Counter = { s = "субъективность красоты не делает её произвольной — красота требует отклика, а отклик требует общности восприятия" } ;
    ArguedSynthesisBeauty1Synthesis = { s = "красота соединяет субъективное переживание и интерсубъективное признание" } ;
    ArguedCounterDuty1Counter = { s = "долг, лишённый внутреннего согласия, превращается в принуждение — и перестаёт быть моральным" } ;
    ArguedSynthesisDuty1Synthesis = { s = "зрелый долг — не подчинение внешнему правилу, а принятие правила как своего" } ;
    ArguedCounterTrust1Counter = { s = "доверие уязвимо: один провал может разрушить то, что строилось годами — потому что доверие асимметрично" } ;
    ArguedSynthesisTrust1Synthesis = { s = "доверие — не ставка на гарантию, а решение принять риск" } ;
    ArguedCounterHope1Counter = { s = "надежда без действия — фантазия; она утешает, но не меняет" } ;
    ArguedSynthesisHope1Synthesis = { s = "надежда работает только в паре с действием: она показывает направление, но не заменяет движение" } ;
    ArguedCounterJustice1Counter = { s = "соразмерность трудно измерить: как взвесить страдание или измерить ущерб намерению?" } ;
    ArguedSynthesisJustice1Synthesis = { s = "справедливость — не точная формула, а направление: стремление к соразмерности важнее точности" } ;
    ArguedCounterTime1Counter = { s = "необратимость времени — не только ограничение; она же — условие осмысленности выбора: если всё можно отменить, ничто не имеет веса" } ;
    ArguedSynthesisTime1Synthesis = { s = "время — не просто измерение физики, а условие, при котором действия имеют последствия" } ;
    ArguedCounterReason1Counter = { s = "самокоррекция требует того, что разуму даётся труднее всего: признания собственной неправоты" } ;
    ArguedSynthesisReason1Synthesis = { s = "разум — не инструмент для подтверждения уже известного, а дисциплина сомнения в нём" } ;
    ArguedCounterBeing1Counter = { s = "это не освобождает от ответственности: то, что бытие предшествует сущности, означает, что сущность — наша задача, а не данность" } ;
    ArguedSynthesisBeing1Synthesis = { s = "вопрос «кто я» не имеет готового ответа — он имеет только траекторию ответа" } ;
    ArguedCounterHistory1Counter = { s = "интерпретация принадлежит интерпретатору — и каждая эпоха переписывает историю под свои вопросы" } ;
    ArguedSynthesisHistory1Synthesis = { s = "история — не хроника, а спор о смысле произошедшего" } ;
    ArguedCounterLanguage1Counter = { s = "язык не только ограничивает — он же и расширяет: новое слово создаёт новую возможность мысли" } ;
    ArguedSynthesisLanguage1Synthesis = { s = "язык — не инструмент для выражения готовых мыслей, а среда, в которой мысли рождаются" } ;
    ArguedCounterWill1Counter = { s = "сила воли не бесконечна — она истощается, как мышца, и требует восстановления" } ;
    ArguedSynthesisWill1Synthesis = { s = "воля — не характер, а практика: она тренируется через повторение, а не даётся от рождения" } ;
    ArguedCounterDeath1Counter = { s = "осознание смерти не должно парализовать — оно должно обострять: жить так, будто времени бесконечно много — значит не жить вовсе" } ;
    ArguedSynthesisDeath1Synthesis = { s = "смерть — не противоположность жизни, а её условие осмысленности" } ;
    ArguedCounterSolitude1Counter = { s = "одиночество — не всегда отсутствие других; иногда это присутствие себя, с которым трудно быть наедине" } ;
    ArguedSynthesisSolitude1Synthesis = { s = "одиночество — не диагноз, а состояние: оно может быть выбрано, а может быть навязано, и это меняет всё" } ;
    ArguedCounterLove1Counter = { s = "признание ценности другого не означает слияния с ним — любовь сохраняет границу между я и ты" } ;
    ArguedSynthesisLove1Synthesis = { s = "любовь — не поглощение и не растворение, а присутствие рядом с тем, чья инаковость признана и сохранена" } ;
    ArguedCounterLabour1Counter = { s = "труд, лишённый смысла, не преобразует — он истощает, превращая человека в функцию" } ;
