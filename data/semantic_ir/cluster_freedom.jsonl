{"id": "cl-001", "stratum": "negation", "pair": null, "text": "Свобода не продаётся.", "sexpr": "(Not (Apply sellable ((theme (Concept freedom)))))", "note": "freedom not a commodity"}
{"id": "cl-002", "stratum": "quantifier", "pair": null, "text": "Каждый заслуживает свободы.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply deserves ((agent ?x) (theme (Concept freedom))))))", "note": "universal desert claim"}
{"id": "cl-003", "stratum": "paraphrase", "pair": "cl-A", "text": "Свобода — высшая ценность.", "sexpr": "(Apply highest-value ((theme (Concept freedom))))", "note": "value superlative"}
{"id": "cl-004", "stratum": "paraphrase", "pair": "cl-A", "text": "Нет ценности выше свободы.", "sexpr": "(Apply highest-value ((theme (Concept freedom))))", "note": "identical IR to cl-003"}
{"id": "cl-005", "stratum": "negation", "pair": null, "text": "Свобода одного кончается там, где начинается свобода другого.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (AtTime when-other-freedom-begins (Not (Apply extends ((theme (Concept own-freedom))))))))", "note": "classic boundary formula"}
{"id": "cl-006", "stratum": "quantifier", "pair": null, "text": "Всякая свобода имеет цену.", "sexpr": "(Forall ?x (Implies (Apply freedom-state ((theme ?x))) (Exists ?c (And (Apply price ((theme ?c))) (Apply has ((agent ?x) (theme ?c)))))))", "note": "cost of freedom"}
{"id": "cl-007", "stratum": "polysemy", "pair": null, "text": "Свобода слова — не свобода оскорблений.", "sexpr": "(Not (Apply equals ((theme (Concept speech-liberty)) (value (Concept liberty-to-insult)))))", "note": "speech-liberty bounded"}
{"id": "cl-008", "stratum": "negation", "pair": null, "text": "Свободный человек не боится.", "sexpr": "(Forall ?x (Implies (Apply is-free ((theme ?x))) (Not (Apply fears ((agent ?x))))))", "note": "fearlessness claim"}
{"id": "cl-009", "stratum": "quantifier", "pair": null, "text": "Некоторые путают свободу со вседозволенностью.", "sexpr": "(Exists ?x (And (Apply person ((theme ?x))) (Apply confuses ((agent ?x) (theme (Concept freedom)) (with (Concept permissiveness))))))", "note": "confusion existential"}
{"id": "cl-010", "stratum": "paraphrase", "pair": null, "text": "Быть свободным — значит отвечать за себя.", "sexpr": "(Implies (Apply is-free ((theme (Concept anyone)))) (Apply responsible-for-self ((agent (Concept anyone)))))", "note": "freedom-responsibility link, solo"}
{"id": "cl-011", "stratum": "negation", "pair": null, "text": "Свобода не даётся даром.", "sexpr": "(Not (Apply given-freely ((theme (Concept freedom)))))", "note": "no free freedom"}
{"id": "cl-012", "stratum": "quantifier", "pair": null, "text": "Все хотят свободы.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply wants ((agent ?x) (theme (Concept freedom))))))", "note": "universal desire"}
{"id": "cl-013", "stratum": "quantifier", "pair": null, "text": "Выбор всегда личный.", "sexpr": "(Forall ?x (Implies (Apply choice ((theme ?x))) (Apply personal ((theme ?x)))))", "note": "choice personality"}
{"id": "cl-014", "stratum": "negation", "pair": null, "text": "Выбора не избежать.", "sexpr": "(Not (Exists ?x (And (Apply situation ((theme ?x))) (Not (Apply involves-choice ((theme ?x)))))))", "note": "unavoidability, double scope"}
{"id": "cl-015", "stratum": "paraphrase", "pair": "cl-B", "text": "Выбирать — значит отказываться.", "sexpr": "(Implies (Apply chooses ((agent (Concept anyone)))) (Apply refuses-something ((agent (Concept anyone)))))", "note": "choice as refusal"}
{"id": "cl-016", "stratum": "paraphrase", "pair": "cl-B", "text": "Всякий выбор есть отказ.", "sexpr": "(Implies (Apply chooses ((agent (Concept anyone)))) (Apply refuses-something ((agent (Concept anyone)))))", "note": "identical IR to cl-015: choosing entails refusing"}
{"id": "cl-017", "stratum": "quantifier", "pair": null, "text": "Некоторые выбирают сердцем.", "sexpr": "(Exists ?x (And (Apply person ((theme ?x))) (Apply chooses-by-heart ((agent ?x)))))", "note": "affective choice"}
{"id": "cl-018", "stratum": "negation", "pair": null, "text": "Не выбирать — тоже выбор.", "sexpr": "(Apply is-choice ((theme (Concept not-choosing))))", "note": "abstention as choice, affirmative form"}
{"id": "cl-019", "stratum": "polysemy", "pair": null, "text": "Право выбора принадлежит каждому.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply has-right-to-choose ((agent ?x)))))", "note": "right-to-choose universal"}
{"id": "cl-020", "stratum": "quantifier", "pair": null, "text": "Каждый выбор меняет будущее.", "sexpr": "(Forall ?x (Implies (Apply choice ((theme ?x))) (Apply changes-future ((agent ?x)))))", "note": "choice efficacy"}
{"id": "cl-021", "stratum": "negation", "pair": null, "text": "Трудный выбор — всё равно выбор.", "sexpr": "(Forall ?x (Implies (Apply difficult ((theme ?x))) (Apply is-choice ((theme ?x)))))", "note": "bound universal reading"}
{"id": "cl-022", "stratum": "quantifier", "pair": null, "text": "Возможности есть всегда.", "sexpr": "(AtTime always (Exists ?x (Apply possibility ((theme ?x)))))", "note": "persistent possibility"}
{"id": "cl-023", "stratum": "negation", "pair": null, "text": "Невозможного нет.", "sexpr": "(Not (Exists ?x (Apply impossible ((theme ?x)))))", "note": "denied impossibility"}
{"id": "cl-024", "stratum": "paraphrase", "pair": null, "text": "Возможность — это открытая дверь.", "sexpr": "(Apply equals ((theme (Concept possibility)) (value (Concept open-door))))", "note": "metaphorical equation (solo: converse equations differ by argument order)"}
{"id": "cl-025", "stratum": "paraphrase", "pair": null, "text": "Открытая дверь — это возможность.", "sexpr": "(Apply equals ((theme (Concept open-door)) (value (Concept possibility))))", "note": "converse equation: DIFFERENT IR by design (argument order matters) (solo: converse equations differ by argument order)"}
{"id": "cl-026", "stratum": "quantifier", "pair": null, "text": "Некоторые возможности опасны.", "sexpr": "(Exists ?x (And (Apply possibility ((theme ?x))) (Apply dangerous ((theme ?x)))))", "note": "dangerous opportunities"}
{"id": "cl-027", "stratum": "negation", "pair": null, "text": "Упущенная возможность не возвращается.", "sexpr": "(Forall ?x (Implies (And (Apply possibility ((theme ?x))) (Apply missed ((theme ?x)))) (Not (Apply returns ((theme ?x))))))", "note": "missed chances"}
{"id": "cl-028", "stratum": "polysemy", "pair": null, "text": "Он человек возможностей.", "sexpr": "(Apply is-person-of-means ((theme (Entity he))))", "note": "resourceful person idiom"}
{"id": "cl-029", "stratum": "quantifier", "pair": null, "text": "Все возможности равны.", "sexpr": "(Forall ?x (Implies (Apply possibility ((theme ?x))) (Apply equal ((theme ?x)))))", "note": "contested universal"}
{"id": "cl-030", "stratum": "negation", "pair": null, "text": "Возможность — не гарантия.", "sexpr": "(Not (Apply equals ((theme (Concept possibility)) (value (Concept guarantee)))))", "note": "possibility vs guarantee"}
{"id": "cl-031", "stratum": "negation", "pair": null, "text": "Ограничения формируют характер.", "sexpr": "(Apply forms ((agent (Concept limitations)) (theme (Concept character))))", "note": "affirmative about limits"}
{"id": "cl-032", "stratum": "quantifier", "pair": null, "text": "Всякое ограничение временно.", "sexpr": "(Forall ?x (Implies (Apply limitation ((theme ?x))) (Apply temporary ((theme ?x)))))", "note": "temporariness universal"}
{"id": "cl-033", "stratum": "paraphrase", "pair": "cl-D", "text": "Границы нужны.", "sexpr": "(Apply needed ((theme (Concept boundaries))))", "note": "terse normative"}
{"id": "cl-034", "stratum": "paraphrase", "pair": "cl-D", "text": "Без границ нельзя.", "sexpr": "(Apply needed ((theme (Concept boundaries))))", "note": "identical IR to cl-033: need-claim"}
{"id": "cl-035", "stratum": "negation", "pair": null, "text": "Принуждение убивает доверие.", "sexpr": "(Apply kills ((agent (Concept coercion)) (theme (Concept trust))))", "note": "coercion/trust incompatibility"}
{"id": "cl-036", "stratum": "quantifier", "pair": null, "text": "Всякое принуждение заметно.", "sexpr": "(Forall ?x (Implies (Apply coercion ((theme ?x))) (Apply noticeable ((theme ?x)))))", "note": "coercion visibility claim"}
{"id": "cl-037", "stratum": "paraphrase", "pair": "cl-E", "text": "Давление — тоже принуждение.", "sexpr": "(Apply is-form-of ((theme (Concept pressure)) (value (Concept coercion))))", "note": "pressure classified"}
{"id": "cl-038", "stratum": "paraphrase", "pair": null, "text": "Всякое давление есть принуждение.", "sexpr": "(Forall ?x (Implies (Apply pressure ((theme ?x))) (Apply is-coercion ((theme ?x)))))", "note": "universalized form; IR differs from cl-037 by design (solo)"}
{"id": "cl-039", "stratum": "negation", "pair": null, "text": "Угроза — не аргумент.", "sexpr": "(Not (Apply equals ((theme (Concept threat)) (value (Concept argument)))))", "note": "threat/argument distinction"}
{"id": "cl-040", "stratum": "quantifier", "pair": null, "text": "Каждая угроза требует ответа.", "sexpr": "(Forall ?x (Implies (Apply threat ((theme ?x))) (Exists ?r (And (Apply response ((theme ?r))) (Apply requires ((agent ?x) (theme ?r)))))))", "note": "threat/response pairing"}
{"id": "cl-041", "stratum": "polysemy", "pair": null, "text": "Он принудил себя улыбнуться.", "sexpr": "(Apply forced-self ((agent (Entity he)) (action (Concept smile))))", "note": "self-coercion reading"}
{"id": "cl-042", "stratum": "negation", "pair": null, "text": "Ненасильственное принуждение бывает.", "sexpr": "(Exists ?x (And (Apply coercion ((theme ?x))) (Not (Apply violent ((theme ?x))))))", "note": "non-violent coercion exists"}
{"id": "cl-043", "stratum": "quantifier", "pair": null, "text": "Все боятся принуждения.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply fears ((agent ?x) (theme (Concept coercion))))))", "note": "universal fear claim"}
{"id": "cl-044", "stratum": "negation", "pair": null, "text": "Ответственность не делится.", "sexpr": "(Not (Apply divisible ((theme (Concept responsibility)))))", "note": "indivisibility claim"}
{"id": "cl-045", "stratum": "quantifier", "pair": null, "text": "Каждый отвечает за своё.", "sexpr": "(Forall ?x (Apply responsible-for-own ((agent ?x))))", "note": "own-share responsibility"}
{"id": "cl-046", "stratum": "paraphrase", "pair": "cl-F", "text": "Взять ответственность — значит повзрослеть.", "sexpr": "(Implies (Apply takes ((agent (Concept anyone)) (theme (Concept responsibility)))) (Apply matures ((agent (Concept anyone)))))", "note": "responsibility as maturation"}
{"id": "cl-047", "stratum": "paraphrase", "pair": "cl-F", "text": "Ответственность делает взрослым.", "sexpr": "(Implies (Apply takes ((agent (Concept anyone)) (theme (Concept responsibility)))) (Apply matures ((agent (Concept anyone)))))", "note": "identical IR to cl-046"}
{"id": "cl-048", "stratum": "negation", "pair": null, "text": "Чужая вина — не твоя ответственность.", "sexpr": "(Not (Apply equals ((theme (Concept чужой-вины)) (value (Concept твоей-ответственности)))))", "note": "Cyrillic ids — parser must accept non-English tokens"}
{"id": "cl-049", "stratum": "quantifier", "pair": null, "text": "Ответственность растёт с властью.", "sexpr": "(Forall ?x (Implies (Apply power ((theme ?x))) (Exists ?r (And (Apply responsibility ((theme ?r))) (Apply grows-with ((agent ?r) (theme ?x)))))))", "note": "power/responsibility correlation"}
{"id": "cl-050", "stratum": "polysemy", "pair": null, "text": "Он ответственный человек.", "sexpr": "(Apply is-responsible-person ((theme (Entity he))))", "note": "trait reading vs act reading"}
{"id": "cl-051", "stratum": "negation", "pair": null, "text": "Безответственность разрушает доверие.", "sexpr": "(Apply destroys ((agent (Concept irresponsibility)) (theme (Concept trust))))", "note": "causal claim"}
{"id": "cl-052", "stratum": "quantifier", "pair": null, "text": "Намерения не всегда ясны.", "sexpr": "(Not (Forall ?x (Implies (Apply intention ((theme ?x))) (Apply clear ((theme ?x))))))", "note": "opacity of intentions"}
{"id": "cl-053", "stratum": "paraphrase", "pair": "cl-G", "text": "Он хотел как лучше.", "sexpr": "(Apply meant-well ((agent (Entity he))))", "note": "good-intention idiom"}
{"id": "cl-054", "stratum": "paraphrase", "pair": "cl-G", "text": "Намерения у него были добрые.", "sexpr": "(Apply meant-well ((agent (Entity he))))", "note": "identical IR to cl-053"}
{"id": "cl-055", "stratum": "negation", "pair": null, "text": "Добрыми намерениями дорога в ад вымощена.", "sexpr": "(Forall ?x (Implies (Apply good-intentions ((theme ?x))) (Not (Apply good-outcome ((theme ?x))))))", "note": "bound universal reading"}
{"id": "cl-056", "stratum": "quantifier", "pair": null, "text": "Каждое намерение проверяется делом.", "sexpr": "(Forall ?x (Implies (Apply intention ((theme ?x))) (Apply tested-by-deed ((theme ?x)))))", "note": "deeds test intentions"}
{"id": "cl-057", "stratum": "polysemy", "pair": null, "text": "Умысел отличен от намерения.", "sexpr": "(Not (Apply equals ((theme (Concept intent-malice)) (value (Concept intention)))))", "note": "legal vs general sense"}
{"id": "cl-058", "stratum": "negation", "pair": null, "text": "Намерение — ещё не поступок.", "sexpr": "(Not (Apply equals ((theme (Concept intention)) (value (Concept deed)))))", "note": "intention/deed distinction"}
{"id": "cl-059", "stratum": "quantifier", "pair": null, "text": "Скрытые намерения есть у всех.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Exists ?i (And (Apply intention ((theme ?i))) (Apply hidden ((theme ?i))) (Apply has ((agent ?x) (theme ?i)))))))", "note": "hidden intentions universal"}
{"id": "cl-060", "stratum": "negation", "pair": null, "text": "Злого умысла не было.", "sexpr": "(Not (Exists ?x (And (Apply intent-malice ((theme ?x))) (Apply present ((theme ?x))))))", "note": "denied malice"}
{"id": "cl-061", "stratum": "quantifier", "pair": null, "text": "Намерения меняются.", "sexpr": "(Forall ?x (Implies (Apply intention ((theme ?x))) (Modal Possible (Apply changes ((theme ?x))))))", "note": "mutability with modality"}
{"id": "cl-062", "stratum": "negation", "pair": null, "text": "Хотеть — не значит мочь.", "sexpr": "(Not (Implies (Apply wants ((agent (Concept anyone)))) (Apply can ((agent (Concept anyone))))))", "note": "want/can distinction"}
{"id": "cl-063", "stratum": "quantifier", "pair": null, "text": "Все понимают намерения по-своему.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply understands-own-way ((agent ?x) (theme (Concept intentions))))))", "note": "interpretive variance"}
{"id": "cl-064", "stratum": "negation", "pair": null, "text": "Намерение без действия мертво.", "sexpr": "(Forall ?x (Implies (And (Apply intention ((theme ?x))) (Not (Exists ?a (And (Apply action ((theme ?a))) (Apply realizes ((agent ?a) (theme ?x))))))) (Apply dead ((theme ?x)))))", "note": "unrealized intentions"}
{"id": "cl-065", "stratum": "quantifier", "pair": null, "text": "Ясные намерения редки.", "sexpr": "(Forall ?x (Implies (And (Apply intention ((theme ?x))) (Apply clear ((theme ?x)))) (Apply rare ((theme ?x)))))", "note": "clarity rarity — check closedness"}
{"id": "cl-066", "stratum": "negation", "pair": null, "text": "Не суди о намерениях по словам.", "sexpr": "(Not (Modal Obligatory (Apply judge-by-words ((theme (Concept intentions))))))", "note": "deontic advice"}
{"id": "cl-067", "stratum": "quantifier", "pair": null, "text": "Осознанность приходит с практикой.", "sexpr": "(Forall ?x (Implies (Apply practice ((theme ?x))) (Exists ?a (And (Apply awareness ((theme ?a))) (Apply brings ((agent ?x) (theme ?a)))))))", "note": "practice/awareness link"}
{"id": "cl-068", "stratum": "negation", "pair": null, "text": "Осознанность — не контроль.", "sexpr": "(Not (Apply equals ((theme (Concept awareness)) (value (Concept control)))))", "note": "awareness/control distinction"}
{"id": "cl-069", "stratum": "quantifier", "pair": null, "text": "Осознанный выбор требует паузы.", "sexpr": "(Forall ?x (Implies (Apply aware-choice ((theme ?x))) (Apply requires-pause ((theme ?x)))))", "note": "pause requirement"}
{"id": "cl-070", "stratum": "paraphrase", "pair": "cl-H", "text": "Живи осознанно.", "sexpr": "(Modal Obligatory (Apply lives ((agent (Concept anyone)) (manner (Concept aware)))))", "note": "imperative as deontic"}
{"id": "cl-071", "stratum": "paraphrase", "pair": null, "text": "Осознанность в каждом дне.", "sexpr": "(Forall ?x (Implies (Apply day ((theme ?x))) (Apply contains ((agent ?x) (theme (Concept awareness))))))", "note": "DIFFERENT IR by design — null the pair below"}
{"id": "cl-072", "stratum": "negation", "pair": null, "text": "Автопилот — враг осознанности.", "sexpr": "(Apply opposes ((agent (Concept autopilot)) (theme (Concept awareness))))", "note": "autopilot opposition"}
{"id": "cl-073", "stratum": "quantifier", "pair": null, "text": "Многие живут не приходя в сознание.", "sexpr": "(Exists ?x (And (Apply person ((theme ?x))) (Not (Apply aware ((theme ?x))))))", "note": "unawareness existential"}
{"id": "cl-074", "stratum": "polysemy", "pair": null, "text": "Осознанность ≠ самоконтроль.", "sexpr": "(Not (Apply equals ((theme (Concept awareness)) (value (Concept self-control)))))", "note": "awareness vs self-control"}
{"id": "cl-075", "stratum": "negation", "pair": null, "text": "Осознанность не гарантирует правильности.", "sexpr": "(Not (Forall ?x (Implies (Apply aware-decision ((theme ?x))) (Apply right ((theme ?x))))))", "note": "awareness/rightness gap"}
{"id": "cl-076", "stratum": "quantifier", "pair": null, "text": "Последствия неизбежны.", "sexpr": "(Forall ?x (Implies (Apply consequence ((theme ?x))) (Apply inevitable ((theme ?x)))))", "note": "inevitability universal"}
{"id": "cl-077", "stratum": "negation", "pair": null, "text": "Последствий не избежать.", "sexpr": "(Not (Exists ?x (And (Apply consequence ((theme ?x))) (Apply avoidable ((theme ?x))))))", "note": "unavoidability, negated form"}
{"id": "cl-078", "stratum": "paraphrase", "pair": "cl-I", "text": "Думай о последствиях.", "sexpr": "(Modal Obligatory (Apply considers ((agent (Concept anyone)) (theme (Concept consequences)))))", "note": "imperative as deontic"}
{"id": "cl-079", "stratum": "paraphrase", "pair": null, "text": "Последствия надо предвидеть.", "sexpr": "(Modal Obligatory (Apply foresees ((agent (Concept anyone)) (theme (Concept consequences)))))", "note": "DIFFERENT IR by design — null the pair below"}
{"id": "cl-080", "stratum": "quantifier", "pair": null, "text": "Каждое действие отзывается эхом.", "sexpr": "(Forall ?x (Implies (Apply action ((theme ?x))) (Exists ?e (And (Apply echo ((theme ?e))) (Apply caused-by ((agent ?e) (theme ?x)))))))", "note": "echo consequences"}
{"id": "cl-081", "stratum": "negation", "pair": null, "text": "Безответственные последствия? Так не бывает.", "sexpr": "(Not (Exists ?x (And (Apply consequence ((theme ?x))) (Not (Exists ?a (And (Apply agent ((theme ?a))) (Apply answers-for ((agent ?a) (theme ?x)))))))))", "note": "every consequence has an answerer"}
{"id": "cl-082", "stratum": "polysemy", "pair": null, "text": "Последствие — не наказание.", "sexpr": "(Not (Apply equals ((theme (Concept consequence)) (value (Concept punishment)))))", "note": "consequence/punishment distinction"}
{"id": "cl-083", "stratum": "quantifier", "pair": null, "text": "Отдалённые последствия важнее близких.", "sexpr": "(Forall ?x (Implies (And (Apply consequence ((theme ?x))) (Apply distant ((theme ?x)))) (Apply more-important ((theme ?x)))))", "note": "distant consequences matter"}
{"id": "cl-084", "stratum": "negation", "pair": null, "text": "Последствия нельзя отменить.", "sexpr": "(Not (Modal Possible (Apply cancelled ((theme (Concept consequences))))))", "note": "irreversibility modal"}
{"id": "cl-085", "stratum": "quantifier", "pair": null, "text": "Хорошие последствия редки.", "sexpr": "(Exists ?x (And (Apply consequence ((theme ?x))) (Apply good ((theme ?x)))))", "note": "good consequences exist"}
{"id": "cl-086", "stratum": "negation", "pair": null, "text": "Непредвиденные последствия — норма.", "sexpr": "(Exists ?x (And (Apply consequence ((theme ?x))) (Apply unforeseen ((theme ?x)))))", "note": "affirmative about unforeseen"}
{"id": "cl-087", "stratum": "quantifier", "pair": null, "text": "Все отвечают за последствия.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Apply answers-for-consequences ((agent ?x)))))", "note": "universal accountability"}
{"id": "cl-088", "stratum": "negation", "pair": null, "text": "Последствия не спрашивают разрешения.", "sexpr": "(Not (Apply asks-permission ((agent (Concept consequences)))))", "note": "personified consequences denied"}
{"id": "cl-089", "stratum": "quantifier", "pair": null, "text": "Каждое последствие учит.", "sexpr": "(Forall ?x (Implies (Apply consequence ((theme ?x))) (Apply teaches ((agent ?x)))))", "note": "didactic consequences"}
{"id": "cl-090", "stratum": "negation", "pair": null, "text": "Плохих последствий не бывает без причин.", "sexpr": "(Forall ?x (Implies (Apply bad-consequence ((theme ?x))) (Exists ?c (And (Apply cause ((theme ?c))) (Apply caused ((agent ?c) (theme ?x)))))))", "note": "causation required"}
{"id": "cl-091", "stratum": "quantifier", "pair": null, "text": "Осознанность лечит.", "sexpr": "(Apply heals ((agent (Concept awareness))))", "note": "terse therapeutic claim"}
{"id": "cl-092", "stratum": "negation", "pair": null, "text": "Неосознанность калечит.", "sexpr": "(Apply maims ((agent (Concept unawareness))))", "note": "mirror claim"}
{"id": "cl-093", "stratum": "paraphrase", "pair": "cl-J", "text": "Выбор есть всегда.", "sexpr": "(AtTime always (Exists ?x (Apply choice ((theme ?x)))))", "note": "persistent choice"}
{"id": "cl-094", "stratum": "paraphrase", "pair": null, "text": "Всегда можно выбрать.", "sexpr": "(AtTime always (Modal Possible (Apply chooses ((agent (Concept anyone))))))", "note": "DIFFERENT IR by design — null the pair below"}
{"id": "cl-095", "stratum": "quantifier", "pair": null, "text": "Ограничения — тоже возможности.", "sexpr": "(Forall ?x (Implies (Apply limitation ((theme ?x))) (Modal Possible (Apply reframed-as-opportunity ((theme ?x))))))", "note": "reframing universal"}
{"id": "cl-096", "stratum": "negation", "pair": null, "text": "Принуждение начинается с мелочей.", "sexpr": "(Apply begins-with ((theme (Concept coercion)) (patient (Concept trifles))))", "note": "affirmative onset claim"}
{"id": "cl-097", "stratum": "quantifier", "pair": null, "text": "Ответственность нельзя делегировать полностью.", "sexpr": "(Forall ?x (Implies (Apply responsibility ((theme ?x))) (Not (Modal Possible (Apply fully-delegated ((theme ?x)))))))", "note": "non-delegability"}
{"id": "cl-098", "stratum": "negation", "pair": null, "text": "Намерениями дорога не вымощена.", "sexpr": "(Not (Apply paves-road ((agent (Concept intentions)))))", "note": "variant of the proverb theme"}
{"id": "cl-099", "stratum": "quantifier", "pair": null, "text": "Каждое «надо» скрывает «хочу».", "sexpr": "(Forall ?x (Implies (Apply ought ((theme ?x))) (Exists ?w (And (Apply want ((theme ?w))) (Apply hidden-behind ((agent ?w) (theme ?x)))))))", "note": "ought conceals want"}
{"id": "cl-100", "stratum": "paraphrase", "pair": null, "text": "Свобода — это ответственность.", "sexpr": "(Apply equals ((theme (Concept freedom)) (value (Concept responsibility))))", "note": "closing equation, solo"}
{"id":"cl-101","stratum":"quantifier","pair":null,"text":"Долженствование сковывает.","sexpr":"(Apply constricts ((agent (Concept oughtness)) (theme (Concept freedom))))","note":"oughtness constricts"}
{"id": "cl-102", "stratum": "negation", "pair": null, "text": "Можно, но не нужно.", "sexpr": "(And (Modal Permitted (Apply does ((agent (Concept anyone))))) (Not (Modal Necessary (Apply does ((agent (Concept anyone)))))))", "note": "permitted but not required"}
{"id": "cl-103", "stratum": "quantifier", "pair": null, "text": "Нельзя запрещать всё подряд.", "sexpr": "(Not (Modal Permitted (Apply bans-indiscriminately ((agent (Concept anyone))))))", "note": "deontic ban on bans"}
{"id": "cl-104", "stratum": "negation", "pair": null, "text": "Обязательное — не всегда принудительное.", "sexpr": "(Not (Forall ?x (Implies (Apply obligatory ((theme ?x))) (Apply coerced ((theme ?x))))))", "note": "obligatory vs coerced"}
{"id":"cl-105","stratum":"quantifier","pair":null,"text":"Разрешённое не всегда доступно.","sexpr":"(Forall ?x (Implies (Apply permitted ((theme ?x))) (Modal Possible (Not (Apply accessible ((theme ?x)))))))","note":"permitted but inaccessible possible"}
{"id": "cl-106", "stratum": "negation", "pair": null, "text": "Долг не спрашивает желания.", "sexpr": "(Not (Apply asks ((agent (Concept duty)) (theme (Concept desire)))))", "note": "duty over desire"}
{"id": "cl-107", "stratum": "quantifier", "pair": null, "text": "Всё дозволенное имеет границу.", "sexpr": "(Forall ?x (Implies (Apply permitted ((theme ?x))) (Exists ?b (And (Apply boundary ((theme ?b))) (Apply has ((agent ?x) (theme ?b)))))))", "note": "permitted things bounded"}
{"id": "cl-108", "stratum": "negation", "pair": null, "text": "Нельзя хотеть за всех.", "sexpr": "(Not (Modal Permitted (Apply wants-for-all ((agent (Concept anyone))))))", "note": "deontic limit"}
{"id": "cl-109", "stratum": "quantifier", "pair": null, "text": "Обязанности есть у каждого.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Exists ?d (And (Apply duty ((theme ?d))) (Apply bears ((agent ?x) (theme ?d)))))))", "note": "universal duties"}
{"id": "cl-110", "stratum": "negation", "pair": null, "text": "Права не даются — они признаются.", "sexpr": "(Not (Apply given ((theme (Concept rights)))))", "note": "rights recognized not granted"}
{"id":"cl-111","stratum":"quantifier","pair":null,"text":"Вчерашний выбор определяет завтра.","sexpr":"(AtTime past (Exists ?x (And (Apply choice ((theme ?x))) (Apply determines ((agent ?x) (theme (Concept tomorrow)))))))","note":"past choice shapes future"}
{"id": "cl-112", "stratum": "negation", "pair": null, "text": "Прошлого не вернуть.", "sexpr": "(Not (Modal Possible (Apply returned ((theme (Concept past))))))", "note": "irreversible past"}
{"id":"cl-113","stratum":"quantifier","pair":null,"text":"Будущее открыто.","sexpr":"(Apply open ((theme (Concept future))))","note":"open future"}
{"id": "cl-114", "stratum": "negation", "pair": null, "text": "Завтра не гарантирует ничего.", "sexpr": "(Not (Exists ?x (And (Apply thing ((theme ?x))) (Apply guaranteed-tomorrow ((theme ?x))))))", "note": "no guaranteed tomorrows"}
{"id":"cl-115","stratum":"quantifier","pair":null,"text":"Сегодняшний отказ — завтрашняя свобода.","sexpr":"(Implies (AtTime today (Apply refuses ((agent (Concept anyone))))) (AtTime tomorrow (Apply is-free ((agent (Concept anyone))))))","note":"temporal implication"}
{"id": "cl-116", "stratum": "negation", "pair": null, "text": "Время не ждёт.", "sexpr": "(Not (Apply waits ((agent (Concept time)))))", "note": "time waits not"}
{"id": "cl-117", "stratum": "quantifier", "pair": null, "text": "Вовремя сказанное слово решает.", "sexpr": "(Forall ?x (Implies (And (Apply word ((theme ?x))) (Apply timely ((theme ?x)))) (Apply decides ((agent ?x)))))", "note": "timely words decide"}
{"id": "cl-118", "stratum": "negation", "pair": null, "text": "Опоздавшее решение — не решение.", "sexpr": "(Forall ?x (Implies (And (Apply decision ((theme ?x))) (Apply late ((theme ?x)))) (Not (Apply counts-as-decision ((theme ?x))))))", "note": "late decisions void"}
{"id": "cl-119", "stratum": "quantifier", "pair": null, "text": "Терпение всегда вознаграждается.", "sexpr": "(AtTime always (Forall ?x (Implies (Apply patience ((theme ?x))) (Apply rewarded ((theme ?x))))))", "note": "temporal universal"}
{"id":"cl-120","stratum":"negation","pair":null,"text":"Спешка губит выбор.","sexpr":"(Apply ruins ((agent (Concept haste)) (theme (Concept choice))))","note":"haste ruins"}
{"id": "cl-121", "stratum": "quantifier", "pair": null, "text": "Если есть выбор, есть ответственность.", "sexpr": "(Forall ?x (Implies (Apply choice-present ((theme ?x))) (Apply responsibility-present ((theme ?x)))))", "note": "choice/responsibility conditional"}
{"id": "cl-122", "stratum": "negation", "pair": null, "text": "Если нет альтернатив, нет и выбора.", "sexpr": "(Implies (Not (Exists ?a (Apply alternative ((theme ?a))))) (Not (Apply exists ((theme (Concept choice))))))", "note": "conditional form of rs-01"}
{"id": "cl-123", "stratum": "quantifier", "pair": null, "text": "Когда знаешь последствия, выбираешь иначе.", "sexpr": "(Forall ?x (Implies (Apply knows-consequences ((agent ?x))) (Apply chooses-differently ((agent ?x)))))", "note": "knowledge changes choice"}
{"id": "cl-124", "stratum": "negation", "pair": null, "text": "Если бы знал, не выбрал бы.", "sexpr": "(Modal Hypothetical (Implies (Apply knew ((agent (Concept anyone)))) (Not (Apply chose ((agent (Concept anyone)))))))", "note": "counterfactual regret"}
{"id": "cl-125", "stratum": "quantifier", "pair": null, "text": "При равных условиях выбирай сердцем.", "sexpr": "(Forall ?x (Implies (Apply equal-conditions ((theme ?x))) (Modal Obligatory (Apply chooses-by-heart ((agent (Concept anyone)))))))", "note": "deontic advice under equality"}
{"id": "cl-126", "stratum": "negation", "pair": null, "text": "Если все согласны, это подозрительно.", "sexpr": "(Implies (Forall ?x (Implies (Apply person ((theme ?x))) (Apply agrees ((agent ?x))))) (Apply suspicious ((theme (Concept consensus)))))", "note": "unanimity suspicion"}
{"id": "cl-127", "stratum": "quantifier", "pair": null, "text": "Где двое, там и разногласие.", "sexpr": "(Forall ?x (Implies (And (Apply person ((theme ?x))) (Exists ?y (And (Apply person ((theme ?y))) (Not (Apply equals ((theme ?x) (value ?y))))))) (Exists ?d (And (Apply disagreement ((theme ?d))) (Apply present ((theme ?d)))))))", "note": "two persons, disagreement"}
{"id": "cl-128", "stratum": "negation", "pair": null, "text": "Если обещано, отговорки не принимаются.", "sexpr": "(Forall ?x (Implies (Apply promised ((theme ?x))) (Not (Apply excuses-accepted ((theme ?x))))))", "note": "no excuses after promise"}
{"id": "cl-129", "stratum": "quantifier", "pair": null, "text": "Когда грозит опасность, свобода отступает.", "sexpr": "(Forall ?x (Implies (Apply danger-threatens ((theme ?x))) (Apply retreats ((agent (Concept freedom))))))", "note": "danger shrinks freedom"}
{"id": "cl-130", "stratum": "negation", "pair": null, "text": "Если угроза миновала, страх должен уйти.", "sexpr": "(Implies (Not (Apply exists ((theme (Concept threat))))) (Modal Obligatory (Not (Apply fears ((agent (Concept anyone)))))))", "note": "fear should follow threat out"}
{"id":"cl-131","stratum":"polysemy","pair":null,"text":"Воля к жизни сильнее страха.","sexpr":"(Apply stronger-than ((agent (Concept will-to-live)) (theme (Concept fear))))","note":"will-to-live compound sense"}
{"id": "cl-132", "stratum": "polysemy", "pair": null, "text": "Вольная птица не поёт в клетке.", "sexpr": "(Not (Apply sings ((agent (Concept free-bird)) (place (Concept cage)))))", "note": "вольная = free (liberty sense, attributive)"}
{"id": "cl-133", "stratum": "polysemy", "pair": null, "text": "Дай волю гневу — пожалеешь.", "sexpr": "(Implies (Apply unleashes ((agent (Concept anyone)) (theme (Concept anger)))) (Apply regrets ((agent (Concept anyone)))))", "note": "volya as released force"}
{"id":"cl-134","stratum":"polysemy","pair":null,"text":"Своя воля дороже чужого разрешения.","sexpr":"(Apply dearer-than ((agent (Concept own-will)) (theme (Concept чужое-разрешение))))","note":"Cyrillic id probe: чужое-разрешение"}
{"id": "cl-135", "stratum": "polysemy", "pair": null, "text": "Безвольный человек плывёт по течению.", "sexpr": "(And (Apply lacks ((theme (Concept will-volition)))) (Apply drifts ((agent (Concept person-generic)))))", "note": "lack of volition (concept id reused ok)"}
{"id": "cl-136", "stratum": "quantifier", "pair": null, "text": "Сильная воля видна в мелочах.", "sexpr": "(Forall ?x (Implies (Apply trifle ((theme ?x))) (Apply reveals ((agent ?x) (theme (Concept strong-will))))))", "note": "will visible in trifles"}
{"id": "cl-137", "stratum": "negation", "pair": null, "text": "Волевое решение не обсуждается.", "sexpr": "(Not (Apply discussed ((theme (Concept волевое-решение)))))", "note": "Cyrillic id probe 2"}
{"id": "cl-138", "stratum": "polysemy", "pair": null, "text": "Волю не сломить.", "sexpr": "(Not (Modal Possible (Apply broken ((theme (Concept will-volition))))))", "note": "unbreakable volition modal"}
{"id": "cl-139", "stratum": "quantifier", "pair": null, "text": "Кто хочет, тот может.", "sexpr": "(Forall ?x (Implies (Apply wants ((agent ?x))) (Modal Possible (Apply can ((agent ?x))))))", "note": "want/can proverb shape"}
{"id": "cl-140", "stratum": "negation", "pair": null, "text": "Хотеть мало.", "sexpr": "(Not (Apply sufficient ((theme (Concept wanting)))))", "note": "wanting insufficient"}
{"id": "cl-141", "stratum": "quantifier", "pair": null, "text": "Мочь — ещё не значит делать.", "sexpr": "(Forall ?x (Implies (Apply can ((agent ?x))) (Not (Implies (Apply can ((agent ?x))) (Apply does ((agent ?x)))))))", "note": "can/does gap, nested implication"}
{"id": "cl-142", "stratum": "negation", "pair": null, "text": "Не могу — не оправдание.", "sexpr": "(Not (Apply equals ((theme (Concept inability-claim)) (value (Concept excuse)))))", "note": "inability vs excuse"}
{"id": "cl-143", "stratum": "quantifier", "pair": null, "text": "Всё могущее — не всё должное.", "sexpr": "(Not (Forall ?x (Implies (Apply can-do ((agent ?x))) (Apply should-do ((agent ?x))))))", "note": "can/should gap"}
{"id": "cl-144", "stratum": "negation", "pair": null, "text": "Мочь без хотеть — машина.", "sexpr": "(Forall ?x (Implies (And (Apply can ((agent ?x))) (Not (Apply wants ((agent ?x))))) (Apply is-machine ((agent ?x)))))", "note": "UNBOUND ?x — fix below"}
{"id":"cl-145","stratum":"quantifier","pair":null,"text":"Желание — двигатель поступка.","sexpr":"(Apply drives ((agent (Concept desire)) (theme (Concept deed))))","note":"desire drives"}
{"id": "cl-146", "stratum": "negation", "pair": null, "text": "Без желания нет движения.", "sexpr": "(Implies (Not (Exists ?d (Apply desire ((theme ?d))))) (Not (Apply exists ((theme (Concept motion))))))", "note": "no desire, no motion"}
{"id": "cl-147", "stratum": "quantifier", "pair": null, "text": "Хотения изменчивы.", "sexpr": "(Forall ?x (Implies (Apply wanting ((theme ?x))) (Apply changeable ((theme ?x)))))", "note": "wantings change"}
{"id":"cl-148","stratum":"negation","pair":null,"text":"Расхотеть — тоже выбор.","sexpr":"(Apply is-choice ((theme (Concept un-wanting))))","note":"un-wanting as choice"}
{"id": "cl-149", "stratum": "quantifier", "pair": null, "text": "Воля без цели слепа.", "sexpr": "(Forall ?x (Implies (And (Apply will-volition-state ((theme ?x))) (Not (Exists ?g (And (Apply goal ((theme ?g))) (Apply has ((agent ?x) (theme ?g))))))) (Apply blind ((theme ?x)))))", "note": "goalless will blind"}
{"id": "cl-150", "stratum": "negation", "pair": null, "text": "Цель без воли мертва.", "sexpr": "(Forall ?x (Implies (And (Apply goal ((theme ?x))) (Not (Exists ?w (And (Apply will-volition ((theme ?w))) (Apply directed-at ((agent ?w) (theme ?x))))))) (Apply dead ((theme ?x)))))", "note": "will-less goal dead"}
{"id": "cl-151", "stratum": "quantifier", "pair": null, "text": "Ответственность за последствия несут все участники.", "sexpr": "(Forall ?x (Implies (Apply participant ((theme ?x))) (Apply bears-consequences ((agent ?x)))))", "note": "participant responsibility"}
{"id": "cl-152", "stratum": "negation", "pair": null, "text": "Последствия не выбирают.", "sexpr": "(Not (Apply chosen ((theme (Concept consequences)))))", "note": "consequences unchosen"}
{"id": "cl-153", "stratum": "quantifier", "pair": null, "text": "Каждое последствие имеет автора.", "sexpr": "(Forall ?x (Implies (Apply consequence ((theme ?x))) (Exists ?a (And (Apply agent ((theme ?a))) (Apply authored ((agent ?a) (theme ?x)))))))", "note": "every consequence authored"}
{"id": "cl-154", "stratum": "negation", "pair": null, "text": "Не все последствия видимы сразу.", "sexpr": "(Not (Forall ?x (Implies (Apply consequence ((theme ?x))) (Apply immediately-visible ((theme ?x))))))", "note": "delayed visibility"}
{"id": "cl-155", "stratum": "quantifier", "pair": null, "text": "Отдалённые последствия тяжелее.", "sexpr": "(Forall ?x (Implies (And (Apply consequence ((theme ?x))) (Apply distant ((theme ?x)))) (Apply weightier ((theme ?x)))))", "note": "distant weight"}
{"id": "cl-156", "stratum": "negation", "pair": null, "text": "Последствие — не приговор.", "sexpr": "(Not (Apply equals ((theme (Concept consequence)) (value (Concept verdict)))))", "note": "consequence vs verdict"}
{"id": "cl-157", "stratum": "quantifier", "pair": null, "text": "Хорошие последствия надо замечать.", "sexpr": "(Forall ?x (Implies (And (Apply consequence ((theme ?x))) (Apply good ((theme ?x)))) (Modal Obligatory (Apply noticed ((theme ?x))))))", "note": "notice good outcomes"}
{"id": "cl-158", "stratum": "negation", "pair": null, "text": "Плохие последствия не случайны.", "sexpr": "(Forall ?x (Implies (And (Apply consequence ((theme ?x))) (Apply bad ((theme ?x)))) (Not (Apply accidental ((theme ?x))))))", "note": "bad outcomes caused"}
{"id": "cl-159", "stratum": "quantifier", "pair": null, "text": "Думай о последствиях заранее.", "sexpr": "(Modal Obligatory (Forall ?x (Implies (Apply future-consequence ((theme ?x))) (Apply considered-beforehand ((theme ?x))))))", "note": "deontic foresight"}
{"id": "cl-160", "stratum": "negation", "pair": null, "text": "За последствия не спрятаться.", "sexpr": "(Not (Modal Possible (Apply hidden-from ((theme (Concept consequences))))))", "note": "inescapable outcomes"}
{"id":"cl-161","stratum":"quantifier","pair":null,"text":"Осознанность начинается с паузы.","sexpr":"(Apply begins-with ((theme (Concept awareness)) (patient (Concept pause))))","note":"pause origin"}
{"id": "cl-162", "stratum": "negation", "pair": null, "text": "Осознанность не приходит сама.", "sexpr": "(Not (Apply comes-alone ((theme (Concept awareness)))))", "note": "requires practice"}
{"id": "cl-163", "stratum": "quantifier", "pair": null, "text": "Каждая пауза — шанс осознать.", "sexpr": "(Forall ?x (Implies (Apply pause ((theme ?x))) (Exists ?c (And (Apply chance ((theme ?c))) (Apply for-awareness ((theme ?c)))))))", "note": "pause as chance"}
{"id": "cl-164", "stratum": "negation", "pair": null, "text": "Осознанный не вредит намеренно.", "sexpr": "(Forall ?x (Implies (Apply aware-person ((theme ?x))) (Not (Apply harms-deliberately ((agent ?x))))))", "note": "awareness excludes malice"}
{"id":"cl-165","stratum":"quantifier","pair":null,"text":"Осознанность заразительна.","sexpr":"(Apply contagious ((theme (Concept awareness))))","note":"terse spread claim"}
{"id": "cl-166", "stratum": "negation", "pair": null, "text": "Нельзя осознать за другого.", "sexpr": "(Not (Modal Possible (Apply aware-for-other ((agent (Concept anyone))))))", "note": "non-transferable"}
{"id": "cl-167", "stratum": "quantifier", "pair": null, "text": "Осознанные люди слушают.", "sexpr": "(Forall ?x (Implies (Apply aware-person ((theme ?x))) (Apply listens ((agent ?x)))))", "note": "listening universal"}
{"id": "cl-168", "stratum": "negation", "pair": null, "text": "Осознанность — не техника.", "sexpr": "(Not (Apply equals ((theme (Concept awareness)) (value (Concept technique)))))", "note": "not a technique"}
{"id": "cl-169", "stratum": "quantifier", "pair": null, "text": "Практика осознанности ежедневна.", "sexpr": "(AtTime daily (Apply practiced ((theme (Concept awareness)))))", "note": "daily practice"}
{"id": "cl-170", "stratum": "negation", "pair": null, "text": "Осознанность не отменяет эмоций.", "sexpr": "(Not (Implies (Apply aware ((theme (Concept anyone)))) (Not (Apply feels ((agent (Concept anyone)))))))", "note": "emotions remain"}
{"id": "cl-171", "stratum": "quantifier", "pair": null, "text": "Ограничения дисциплинируют.", "sexpr": "(Forall ?x (Implies (Apply limitation ((theme ?x))) (Apply disciplines ((agent ?x)))))", "note": "discipline claim"}
{"id": "cl-172", "stratum": "negation", "pair": null, "text": "Не всякое ограничение — клетка.", "sexpr": "(Not (Forall ?x (Implies (Apply limitation ((theme ?x))) (Apply is-cage ((theme ?x))))))", "note": "limits vs cages"}
{"id": "cl-173", "stratum": "quantifier", "pair": null, "text": "Разумные ограничения принимают.", "sexpr": "(Forall ?x (Implies (And (Apply limitation ((theme ?x))) (Apply reasonable ((theme ?x)))) (Modal Possible (Apply accepted ((theme ?x))))))", "note": "reasonable limits acceptable"}
{"id": "cl-174", "stratum": "negation", "pair": null, "text": "Ограничение без объяснения — насилие.", "sexpr": "(Forall ?x (Implies (And (Apply limitation ((theme ?x))) (Not (Exists ?e (And (Apply explanation ((theme ?e))) (Apply accompanies ((agent ?e) (theme ?x))))))) (Apply is-violence ((theme ?x)))))", "note": "unexplained limits"}
{"id": "cl-175", "stratum": "quantifier", "pair": null, "text": "Границы уважают сильные.", "sexpr": "(Forall ?x (Implies (Apply strong ((theme ?x))) (Apply respects-bounds ((agent ?x)))))", "note": "strength respects bounds"}
{"id": "cl-176", "stratum": "negation", "pair": null, "text": "Снимать ограничения надо осторожно.", "sexpr": "(Modal Obligatory (Apply carefully ((theme (Concept limit-removal)))))", "note": "careful deregulation"}
{"id": "cl-177", "stratum": "quantifier", "pair": null, "text": "Временные ограничения полезны.", "sexpr": "(Forall ?x (Implies (And (Apply limitation ((theme ?x))) (Apply temporary ((theme ?x)))) (Apply useful ((theme ?x)))))", "note": "temporary limits useful"}
{"id": "cl-178", "stratum": "negation", "pair": null, "text": "Ограничения не вечны.", "sexpr": "(Not (Exists ?x (And (Apply limitation ((theme ?x))) (Apply eternal ((theme ?x))))))", "note": "no eternal limits"}
{"id":"cl-179","stratum":"quantifier","pair":null,"text":"Самоограничение — высшая форма.","sexpr":"(Apply highest-form ((theme (Concept self-limitation))))","note":"self-limitation praised"}
{"id": "cl-180", "stratum": "negation", "pair": null, "text": "Внешние ограничения не определяют тебя.", "sexpr": "(Forall ?x (Implies (Apply person ((theme ?x))) (Not (Apply defines ((agent (Concept external-limits)) (theme ?x))))))", "note": "external limits don't define"}
{"id":"cl-181","stratum":"quantifier","pair":null,"text":"Ответственность греет.","sexpr":"(Apply warms ((agent (Concept responsibility))))","note":"terse warmth claim"}
{"id": "cl-182", "stratum": "negation", "pair": null, "text": "Ответственность не тяготит зрелых.", "sexpr": "(Forall ?x (Implies (Apply mature ((theme ?x))) (Not (Apply burdened-by ((agent ?x) (theme (Concept responsibility)))))))", "note": "maturity unburdened"}
{"id": "cl-183", "stratum": "quantifier", "pair": null, "text": "Делить ответственность — нормально.", "sexpr": "(Modal Permitted (Apply shared ((theme (Concept responsibility)))))", "note": "sharing permitted"}
{"id": "cl-184", "stratum": "negation", "pair": null, "text": "Ответственность не делегируется совестью.", "sexpr": "(Not (Modal Possible (Apply delegated ((theme (Concept responsibility)) (means (Concept conscience))))))", "note": "conscience can't delegate"}
{"id": "cl-185", "stratum": "quantifier", "pair": null, "text": "Зрелость измеряется ответственностью.", "sexpr": "(Forall ?x (Implies (Apply mature ((theme ?x))) (Apply measured-by ((agent ?x) (theme (Concept responsibility))))))", "note": "maturity metric"}
{"id":"cl-186","stratum":"negation","pair":null,"text":"Безответственность заразна.","sexpr":"(Apply contagious ((theme (Concept irresponsibility))))","note":"mirror of awareness claim"}
{"id": "cl-187", "stratum": "quantifier", "pair": null, "text": "Ответственные люди спят спокойно.", "sexpr": "(Forall ?x (Implies (Apply responsible-person ((theme ?x))) (Apply sleeps-well ((agent ?x)))))", "note": "sleep well claim"}
{"id": "cl-188", "stratum": "negation", "pair": null, "text": "Ответственность не требует похвалы.", "sexpr": "(Not (Apply requires ((theme (Concept responsibility)) (patient (Concept praise)))))", "note": "no praise needed"}
{"id":"cl-189","stratum":"quantifier","pair":null,"text":"Принуждение начинается с языка.","sexpr":"(Apply begins-with ((theme (Concept coercion)) (patient (Concept language-pressure))))","note":"linguistic onset"}
{"id": "cl-190", "stratum": "negation", "pair": null, "text": "Просьба — не принуждение.", "sexpr": "(Not (Apply equals ((theme (Concept request)) (value (Concept coercion)))))", "note": "request/coercion boundary"}
{"id":"cl-191","stratum":"quantifier","pair":null,"text":"Убеждение отличается от принуждения.","sexpr":"(Apply differs-from ((theme (Concept persuasion)) (target (Concept coercion))))","note":"persuasion boundary"}
{"id": "cl-192", "stratum": "negation", "pair": null, "text": "Стимул — не принуждение.", "sexpr": "(Not (Apply equals ((theme (Concept incentive)) (value (Concept coercion)))))", "note": "incentive boundary (concept §7 packet!)"}
{"id":"cl-193","stratum":"quantifier","pair":null,"text":"Манипуляция — скрытое принуждение.","sexpr":"(Apply is-hidden-form-of ((theme (Concept manipulation)) (value (Concept coercion))))","note":"manipulation classified"}
{"id": "cl-194", "stratum": "negation", "pair": null, "text": "Принуждение к добру — всё равно принуждение.", "sexpr": "(Forall ?x (Implies (And (Apply coercion ((theme ?x))) (Apply aims-at-good ((theme ?x)))) (Apply is-coercion ((theme ?x)))))", "note": "ends don't reclassify"}
{"id": "cl-195", "stratum": "quantifier", "pair": null, "text": "Намерение видно по делам.", "sexpr": "(Forall ?x (Implies (Apply intention ((theme ?x))) (Apply visible-in-deeds ((theme ?x)))))", "note": "deeds reveal"}
