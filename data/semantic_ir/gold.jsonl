{"id":"neg-001","stratum":"negation","pair":null,"text":"Принуждение — это не забота.","sexpr":"(Not (Apply is ((theme (Concept coercion)) (value (Concept care)))))","note":"simple sentential negation over identity"}
{"id":"neg-002","stratum":"negation","pair":null,"text":"Не всякое ограничение — принуждение.","sexpr":"(Not (Forall ?x (Implies (Apply limitation ((theme ?x))) (Apply is ((theme ?x) (value (Concept coercion)))))))","note":"«не всякое» = Not(Forall), not Forall(Not)"}
{"id":"neg-003","stratum":"negation","pair":null,"text":"Ни один выбор не свободен от последствий.","sexpr":"(Forall ?x (Implies (Apply choice ((theme ?x))) (Not (Apply free-from ((theme ?x) (source (Concept consequence)))))))","note":"«ни один» = Forall + inner Not"}
{"id": "neg-004", "stratum": "negation", "pair": null, "text": "Свобода не означает произвол.", "sexpr": "(Not (Apply equals ((theme (Concept freedom)) (value (Concept arbitrariness)))))", "note": "negated predicate, narrow scope on the equation"}
{"id": "neg-005", "stratum": "negation", "pair": null, "text": "Незнание не служит оправданием.", "sexpr": "(Not (Apply serves-as ((theme (Concept ignorance)) (value (Concept excuse)))))", "note": "negated copula-like predicate"}
{"id":"neg-006","stratum":"negation","pair":null,"text":"Не каждый может выбирать.","sexpr":"(Not (Forall ?x (Implies (Apply person ((theme ?x))) (Apply can-choose ((agent ?x))))))","note":"negated universal ability claim"}
{"id":"neg-007","stratum":"negation","pair":null,"text":"Никто не выбирает последствия.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Not (Apply chooses ((agent ?x) (theme (Concept consequence)))))))","note":"universal with negated matrix"}
{"id": "neg-008", "stratum": "negation", "pair": null, "text": "Вынужденное согласие — не согласие.", "sexpr": "(Not (Apply equals ((theme (Concept forced-consent)) (value (Concept consent)))))", "note": "sortal distinction via negated identity"}
{"id": "neg-009", "stratum": "negation", "pair": null, "text": "Ответственность нельзя переложить.", "sexpr": "(Not (Apply shiftable ((theme (Concept responsibility)))))", "note": "negated possibility predicate, single role"}
{"id":"neg-010","stratum":"negation","pair":null,"text":"Не всякое «можно» — свобода.","sexpr":"(Not (Forall ?x (Implies (Apply permitted ((theme ?x))) (Apply is ((theme ?x) (value (Concept freedom)))))))","note":"permission does not entail freedom"}
{"id": "neg-011", "stratum": "negation", "pair": null, "text": "Молчание — не согласие.", "sexpr": "(Not (Apply equals ((theme (Concept silence)) (value (Concept consent)))))", "note": "absence of dissent is not consent"}
{"id": "neg-012", "stratum": "negation", "pair": null, "text": "Не каждое желание исполнимо.", "sexpr": "(Not (Forall ?x (Implies (Apply desire ((theme ?x))) (Apply feasible ((theme ?x))))))", "note": "desire/feasibility scope"}
{"id": "neg-013", "stratum": "negation", "pair": null, "text": "Привычка — не выбор.", "sexpr": "(Not (Apply equals ((theme (Concept habit)) (value (Concept choice)))))", "note": "automaticity excluded from choice"}
{"id":"neg-014","stratum":"negation","pair":null,"text":"Никакое правило не покрывает все случаи.","sexpr":"(Forall ?x (Implies (Apply rule ((theme ?x))) (Not (Forall ?y (Implies (Apply case ((theme ?y))) (Apply covers ((agent ?x) (theme ?y))))))))","note":"nested quantifiers, both bound and used"}
{"id": "neg-015", "stratum": "negation", "pair": null, "text": "Свобода не терпит принуждения.", "sexpr": "(Not (Apply tolerates ((agent (Concept freedom)) (theme (Concept coercion)))))", "note": "negated attitude predicate"}
{"id": "neg-016", "stratum": "negation", "pair": null, "text": "Не всё, что разрешено, — правильно.", "sexpr": "(Not (Forall ?x (Implies (Apply permitted ((theme ?x))) (Apply right ((theme ?x))))))", "note": "permitted vs right distinction"}
{"id": "neg-017", "stratum": "negation", "pair": null, "text": "Отсутствие запрета — не разрешение.", "sexpr": "(Not (Apply equals ((theme (Concept absence-of-ban)) (value (Concept permission)))))", "note": "absence of ban is not permission"}
{"id":"neg-018","stratum":"negation","pair":null,"text":"Никто не обязан соглашаться.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Not (Modal Obligatory (Apply agree ((agent ?x)))))))","note":"negated deontic modality"}
{"id": "neg-019", "stratum": "negation", "pair": null, "text": "Хотеть за другого нельзя.", "sexpr": "(Not (Apply allowed ((action (Concept wanting-for-another)))))", "note": "single-role negated permission"}
{"id":"neg-020","stratum":"negation","pair":null,"text":"Не всякий порядок — справедливость.","sexpr":"(Not (Forall ?x (Implies (Apply order ((theme ?x))) (Apply is ((theme ?x) (value (Concept justice)))))))","note":"order/justice distinction"}
{"id": "neg-021", "stratum": "negation", "pair": null, "text": "Страх не должен решать.", "sexpr": "(Not (Apply should-decide ((agent (Concept fear)))))", "note": "negated normative agent role"}
{"id":"neg-022","stratum":"negation","pair":null,"text":"Неверно, что выбор несвободен.","sexpr":"(Not (Not (Apply is-free ((theme (Concept choice))))))","note":"double negation preserved structurally, not collapsed"}
{"id":"neg-023","stratum":"negation","pair":null,"text":"Не существует выбора без альтернативы.","sexpr":"(Not (Exists ?x (And (Apply choice ((theme ?x))) (Not (Apply has-alternative ((theme ?x)))))))","note":"negated existence with inner negation"}
{"id": "neg-024", "stratum": "negation", "pair": null, "text": "Вынужденное обещание — не обещание.", "sexpr": "(Not (Apply equals ((theme (Concept coerced-promise)) (value (Concept promise)))))", "note": "defective instance excluded from the kind"}
{"id":"neg-025","stratum":"negation","pair":null,"text":"Не каждый отказ — свобода.","sexpr":"(Not (Forall ?x (Implies (Apply refusal ((theme ?x))) (Apply is ((theme ?x) (value (Concept freedom)))))))","note":"refusal vs freedom distinction"}
{"id": "neg-026", "stratum": "negation", "pair": null, "text": "Сила — не аргумент.", "sexpr": "(Not (Apply equals ((theme (Concept force)) (value (Concept argument)))))", "note": "might does not make right, structurally"}
{"id": "neg-027", "stratum": "negation", "pair": null, "text": "Ничто не исчезает бесследно.", "sexpr": "(Forall ?x (Not (Apply vanishes-without-trace ((theme ?x)))))", "note": "universal negative over events"}
{"id": "neg-028", "stratum": "negation", "pair": null, "text": "Не всё значимое — измеримо.", "sexpr": "(Not (Forall ?x (Implies (Apply meaningful ((theme ?x))) (Apply measurable ((theme ?x))))))", "note": "significance/measurability distinction"}
{"id": "neg-029", "stratum": "negation", "pair": null, "text": "Безответственность — не свобода.", "sexpr": "(Not (Apply equals ((theme (Concept irresponsibility)) (value (Concept freedom)))))", "note": "irresponsibility excluded from freedom"}
{"id":"neg-030","stratum":"negation","pair":null,"text":"Ни одно правило не действует всегда.","sexpr":"(Forall ?x (Implies (Apply rule ((theme ?x))) (Not (AtTime always (Apply applies ((theme ?x)))))))","note":"temporal scope inside negation"}
{"id":"qnt-001","stratum":"quantifier","pair":null,"text":"Все люди могут выбирать.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Apply can-choose ((agent ?x)))))","note":"universal ability, bound variable used"}
{"id":"qnt-002","stratum":"quantifier","pair":null,"text":"Некоторые ограничения защищают.","sexpr":"(Exists ?x (And (Apply limitation ((theme ?x))) (Apply protects ((agent ?x)))))","note":"existential with conjunction"}
{"id":"qnt-003","stratum":"quantifier","pair":null,"text":"Каждый выбор имеет причину.","sexpr":"(Forall ?x (Implies (Apply choice ((theme ?x))) (Exists ?c (And (Apply cause ((theme ?c))) (Apply has ((agent ?x) (theme ?c)))))))","note":"forall-exists nesting, both bound"}
{"id":"qnt-004","stratum":"quantifier","pair":null,"text":"Существует выбор без причины.","sexpr":"(Exists ?x (And (Apply choice ((theme ?x))) (Not (Exists ?c (And (Apply cause ((theme ?c))) (Apply explains ((agent ?c) (theme ?x))))))))","note":"existential denying explanation"}
{"id":"qnt-005","stratum":"quantifier","pair":null,"text":"Каждый человек кого-то уважает.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Exists ?y (And (Apply person ((theme ?y))) (Apply respects ((agent ?x) (theme ?y)))))))","note":"forall-exists scope order"}
{"id":"qnt-006","stratum":"quantifier","pair":null,"text":"Есть человек, которого уважают все.","sexpr":"(Exists ?y (And (Apply person ((theme ?y))) (Forall ?x (Implies (Apply person ((theme ?x))) (Apply respects ((agent ?x) (theme ?y)))))))","note":"exists-forall scope order: NOT equivalent to qnt-005"}
{"id":"qnt-007","stratum":"quantifier","pair":null,"text":"Все свободны, но не все равны.","sexpr":"(And (Forall ?x (Implies (Apply person ((theme ?x))) (Apply is-free ((theme ?x))))) (Not (Forall ?y (Implies (Apply person ((theme ?y))) (Apply is-equal ((theme ?y)))))))","note":"conjunction of universal and negated universal"}
{"id":"qnt-008","stratum":"quantifier","pair":null,"text":"Только осознанный выбор — свободный.","sexpr":"(Forall ?x (Implies (Apply is-free-choice ((theme ?x))) (Apply aware-choice ((theme ?x)))))","note":"«только» as reverse implication"}
{"id":"qnt-009","stratum":"quantifier","pair":null,"text":"Некоторые обещания невозможно выполнить.","sexpr":"(Exists ?x (And (Apply promise ((theme ?x))) (Not (Modal Possible (Apply fulfilled ((theme ?x)))))))","note":"existential with negated possibility"}
{"id":"qnt-010","stratum":"quantifier","pair":null,"text":"Каждое действие имеет последствие.","sexpr":"(Forall ?x (Implies (Apply action ((theme ?x))) (Exists ?c (And (Apply consequence ((theme ?c))) (Apply follows ((agent ?c) (theme ?x)))))))","note":"action/consequence pairing"}
{"id":"qnt-011","stratum":"quantifier","pair":null,"text":"Не все последствия предсказуемы.","sexpr":"(Not (Forall ?x (Implies (Apply consequence ((theme ?x))) (Apply predictable ((theme ?x))))))","note":"negated universal, not universal negation"}
{"id":"qnt-012","stratum":"quantifier","pair":null,"text":"Существует ответственность без вины.","sexpr":"(Exists ?x (And (Apply responsibility ((theme ?x))) (Not (Apply involves-guilt ((theme ?x))))))","note":"responsibility without guilt"}
{"id":"qnt-013","stratum":"quantifier","pair":null,"text":"Каждый имеет право на ошибку.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Modal Permitted (Apply errs ((agent ?x))))))","note":"universal deontic permission"}
{"id":"qnt-014","stratum":"quantifier","pair":null,"text":"Все правила имеют исключения.","sexpr":"(Forall ?x (Implies (Apply rule ((theme ?x))) (Exists ?e (And (Apply exception ((theme ?e))) (Apply has ((agent ?x) (theme ?e)))))))","note":"rules/exceptions pairing"}
{"id":"qnt-015","stratum":"quantifier","pair":null,"text":"Некоторые вопросы не имеют ответов.","sexpr":"(Exists ?x (And (Apply question ((theme ?x))) (Not (Exists ?a (And (Apply answer ((theme ?a))) (Apply answers ((agent ?a) (theme ?x))))))))","note":"unanswerable questions"}
{"id":"qnt-016","stratum":"quantifier","pair":null,"text":"Каждый поступок что-то меняет.","sexpr":"(Forall ?x (Implies (Apply deed ((theme ?x))) (Exists ?y (Apply changes ((agent ?x) (theme ?y))))))","note":"bound existential object, closed"}
{"id":"qnt-017","stratum":"quantifier","pair":null,"text":"Всегда есть альтернатива.","sexpr":"(AtTime always (Exists ?x (Apply alternative ((theme ?x)))))","note":"temporal scope over existence"}
{"id":"qnt-018","stratum":"quantifier","pair":null,"text":"Иногда промедление — тоже решение.","sexpr":"(AtTime sometimes (Exists ?x (And (Apply delay ((theme ?x))) (Apply is-decision ((theme ?x))))))","note":"temporal restriction on the claim"}
{"id":"qnt-019","stratum":"quantifier","pair":null,"text":"Всякая власть развращает.","sexpr":"(Forall ?x (Implies (Apply power ((theme ?x))) (Apply corrupts ((agent ?x)))))","note":"universal causal claim"}
{"id":"qnt-020","stratum":"quantifier","pair":null,"text":"Некоторые запреты спасают.","sexpr":"(Exists ?x (And (Apply ban ((theme ?x))) (Apply saves ((agent ?x)))))","note":"protective bans exist"}
{"id":"qnt-021","stratum":"quantifier","pair":null,"text":"Каждый договор держится на доверии.","sexpr":"(Forall ?x (Implies (Apply contract ((theme ?x))) (Apply rests-on ((theme ?x) (basis (Concept trust))))))","note":"basis role for grounding"}
{"id":"qnt-022","stratum":"quantifier","pair":null,"text":"Существует свобода без ответственности.","sexpr":"(Exists ?x (And (Apply freedom-state ((theme ?x))) (Not (Apply involves ((theme ?x) (patient (Concept responsibility)))))))","note":"contested existential, kept as claim not fact"}
{"id":"qnt-023","stratum":"quantifier","pair":null,"text":"Все люди ошибаются.","sexpr":"(Forall ?x (Implies (Apply person ((theme ?x))) (Apply errs ((agent ?x)))))","note":"plain universal"}
{"id":"qnt-024","stratum":"quantifier","pair":null,"text":"Некоторые ошибки неисправимы.","sexpr":"(Exists ?x (And (Apply mistake ((theme ?x))) (Not (Modal Possible (Apply corrected ((theme ?x)))))))","note":"irreversible mistakes"}
{"id":"qnt-025","stratum":"quantifier","pair":null,"text":"Каждый сам решает за себя.","sexpr":"(Forall ?x (Apply decides-for-self ((agent ?x))))","note":"reflexive agency, single binding"}
{"id":"qnt-026","stratum":"quantifier","pair":null,"text":"Возможно, выбор уже сделан.","sexpr":"(Modal Possible (Exists ?x (And (Apply choice ((theme ?x))) (Apply already-made ((theme ?x))))))","note":"epistemic modality over existence"}
{"id":"qnt-027","stratum":"quantifier","pair":null,"text":"Необходимо различать причину и повод.","sexpr":"(Modal Necessary (Apply distinguish ((agent (Concept anyone)) (theme (Concept cause)) (from (Concept pretext)))))","note":"deontic cognitive norm, three roles"}
{"id":"qnt-028","stratum":"quantifier","pair":null,"text":"Всегда найдётся тот, кто против.","sexpr":"(AtTime always (Exists ?x (Apply opposes ((agent ?x)))))","note":"temporal persistence of dissent"}
{"id":"qnt-029","stratum":"quantifier","pair":null,"text":"Каждый выбор — отказ от альтернатив.","sexpr":"(Forall ?x (Implies (Apply choice ((theme ?x))) (Apply is-refusal-of ((theme ?x) (patient (Concept alternatives))))))","note":"choice as refusal"}
{"id":"qnt-030","stratum":"quantifier","pair":null,"text":"Есть вещи важнее свободы.","sexpr":"(Exists ?x (Apply more-important-than-freedom ((theme ?x))))","note":"comparative existential, single binding"}
{"id":"pol-001","stratum":"polysemy","pair":null,"text":"У него сильная воля.","sexpr":"(Apply has-strong ((experiencer (Entity he)) (theme (Concept will-volition))))","note":"воля = volition (sense 1 of 3)"}
