{"id":"pol-003","stratum":"polysemy","pair":null,"text":"Выпустили на волю.","sexpr":"(Apply released-to ((theme (Concept prisoner)) (target (Concept outdoors))))","note":"воля = outdoors (sense 3 of 3)"}
{"id":"pol-004","stratum":"polysemy","pair":null,"text":"Мир лучше войны.","sexpr":"(Apply better-than ((theme (Concept peace)) (target (Concept war))))","note":"мир = peace (sense 1 of 2)"}
{"id":"pol-005","stratum":"polysemy","pair":null,"text":"Весь мир узнал новость.","sexpr":"(Apply learned ((agent (Concept world)) (theme (Concept news))))","note":"мир = world (sense 2 of 2)"}
{"id":"pol-006","stratum":"polysemy","pair":null,"text":"Язык заплетается.","sexpr":"(Apply stumbles ((theme (Concept tongue))))","note":"язык = tongue (sense 1 of 2)"}
{"id":"pol-007","stratum":"polysemy","pair":null,"text":"Он знает язык.","sexpr":"(Apply knows ((agent (Entity he)) (theme (Concept language))))","note":"язык = language (sense 2 of 2)"}
{"id":"pol-008","stratum":"polysemy","pair":null,"text":"У неё длинная коса.","sexpr":"(Apply has ((agent (Entity she)) (theme (Concept braid))))","note":"коса = braid (sense 1 of 3)"}
{"id":"pol-009","stratum":"polysemy","pair":null,"text":"Коса нашла на камень.","sexpr":"(Apply hit ((agent (Concept scythe)) (target (Concept stone))))","note":"коса = scythe; idiom kept literal, idiomatic reading unresolved"}
{"id":"pol-010","stratum":"polysemy","pair":null,"text":"Режь лук мелко.","sexpr":"(Apply chop ((agent (Concept anyone)) (theme (Concept onion)) (manner (Concept finely))))","note":"лук = onion (sense 1 of 2)"}
{"id":"pol-011","stratum":"polysemy","pair":null,"text":"Лук натянут.","sexpr":"(Apply is-drawn ((theme (Concept bow-weapon))))","note":"лук = bow weapon (sense 2 of 2)"}
{"id":"pol-012","stratum":"polysemy","pair":null,"text":"Свобода — отсутствие внешнего принуждения.","sexpr":"(Apply equals ((theme (Concept negative-freedom)) (value (Concept absence-of-external-coercion))))","note":"свобода = negative freedom (concept section 3.1)"}
{"id":"pol-013","stratum":"polysemy","pair":null,"text":"Свобода — способность выбирать.","sexpr":"(Apply equals ((theme (Concept agency-freedom)) (value (Concept ability-to-choose))))","note":"свобода = agency freedom"}
{"id":"pol-014","stratum":"polysemy","pair":null,"text":"Свобода — верность собственным основаниям.","sexpr":"(Apply equals ((theme (Concept autonomy-freedom)) (value (Concept fidelity-to-endorsed-reasons))))","note":"свобода = autonomy freedom"}
{"id":"pol-015","stratum":"polysemy","pair":null,"text":"Птица вырвалась на свободу.","sexpr":"(Apply broke-free ((theme (Concept bird)) (target (Concept negative-freedom))))","note":"escape reading selects negative-freedom sense"}
{"id":"pol-016","stratum":"polysemy","pair":null,"text":"Ключ не подходит.","sexpr":"(Not (Apply fits ((theme (Concept key-object)))))","note":"ключ = physical key (sense 1 of 2)"}
{"id":"pol-017","stratum":"polysemy","pair":null,"text":"Ключ к задаче — в условии.","sexpr":"(Apply located-in ((theme (Concept key-to-problem)) (place (Concept statement))))","note":"ключ = solution key (sense 2 of 2)"}
{"id":"pol-018","stratum":"polysemy","pair":null,"text":"Замок заржавел.","sexpr":"(Apply rusted ((theme (Concept lock-object))))","note":"замок = lock (sense 1 of 2)"}
{"id":"pol-019","stratum":"polysemy","pair":null,"text":"Замок стоит на холме.","sexpr":"(Apply stands-on ((theme (Concept castle)) (place (Concept hill))))","note":"замок = castle (sense 2 of 2)"}
{"id":"pol-020","stratum":"polysemy","pair":null,"text":"Хочу мира во всём мире.","sexpr":"(Apply wants ((agent (Entity speaker)) (theme (Concept peace)) (scope (Concept whole-world))))","note":"both мир senses in one sentence, kept distinct"}
{"id":"pol-021","stratum":"polysemy","pair":null,"text":"Дети вырвались на волю.","sexpr":"(Apply broke-out-to ((agent (Concept children)) (target (Concept outdoors))))","note":"воля = outdoors, agentive subject"}
{"id":"pol-022","stratum":"polysemy","pair":null,"text":"Его воля — закон.","sexpr":"(Apply equals ((theme (Concept his-will)) (value (Concept law))))","note":"воля = individual volition as norm"}
{"id":"pol-023","stratum":"polysemy","pair":null,"text":"Язык мой — враг мой.","sexpr":"(Apply is ((theme (Concept tongue)) (value (Concept enemy))))","note":"proverb, tongue sense; figurative reading unresolved"}
{"id":"pol-024","stratum":"polysemy","pair":null,"text":"Мир тесен.","sexpr":"(Apply is-small ((theme (Concept world))))","note":"мир = world, evaluative predicate"}
{"id":"pol-025","stratum":"polysemy","pair":null,"text":"Дай волю рукам!","sexpr":"(Apply allow ((theme (Concept hands)) (manner (Concept freely))))","note":"idiom kept literal, idiomatic reading unresolved"}
{"id":"par-001","stratum":"paraphrase","pair":"par-A","text":"Свобода требует выбора.","sexpr":"(Implies (Not (Exists ?c (And (Apply choice ((theme ?c))) (Apply available ((theme ?c)))))) (Not (Apply exists ((theme (Concept freedom))))))","note":"requires normalized as absent-then-absent conditional"}
{"id":"par-002","stratum":"paraphrase","pair":"par-A","text":"Без возможности выбора свободы нет.","sexpr":"(Implies (Not (Exists ?c (And (Apply choice ((theme ?c))) (Apply available ((theme ?c)))))) (Not (Apply exists ((theme (Concept freedom))))))","note":"identical IR to par-001: the section 2.3 anchor pair"}
{"id":"par-003","stratum":"paraphrase","pair":"par-B","text":"Принуждение ограничивает свободу.","sexpr":"(Apply limits ((agent (Concept coercion)) (theme (Concept freedom))))","note":"active voice"}
{"id":"par-004","stratum":"paraphrase","pair":"par-B","text":"Свобода ограничена принуждением.","sexpr":"(Apply limits ((agent (Concept coercion)) (theme (Concept freedom))))","note":"passive voice, identical IR: voice normalized away"}
{"id":"par-005","stratum":"paraphrase","pair":"par-C","text":"Выбор предполагает альтернативы.","sexpr":"(Implies (Not (Exists ?a (Apply alternative ((theme ?a))))) (Not (Apply exists ((theme (Concept choice))))))","note":"presupposition as conditional"}
{"id":"par-006","stratum":"paraphrase","pair":"par-C","text":"Без альтернатив нет выбора.","sexpr":"(Implies (Not (Exists ?a (Apply alternative ((theme ?a))))) (Not (Apply exists ((theme (Concept choice))))))","note":"identical IR to par-005"}
{"id":"par-007","stratum":"paraphrase","pair":"par-D","text":"Ответственность требует осознанности.","sexpr":"(Implies (Not (Apply aware ((theme (Concept agent-generic))))) (Not (Apply exists ((theme (Concept responsibility))))))","note":"requires as conditional"}
{"id":"par-008","stratum":"paraphrase","pair":"par-D","text":"Без осознанности нет ответственности.","sexpr":"(Implies (Not (Apply aware ((theme (Concept agent-generic))))) (Not (Apply exists ((theme (Concept responsibility))))))","note":"identical IR to par-007"}
{"id":"par-009","stratum":"paraphrase","pair":"par-E","text":"Знание — сила.","sexpr":"(Forall ?x (Implies (Apply knows ((agent ?x))) (Apply is-strong ((theme ?x)))))","note":"nominal aphorism as universal"}
{"id":"par-010","stratum":"paraphrase","pair":"par-E","text":"Кто знает, тот силён.","sexpr":"(Forall ?x (Implies (Apply knows ((agent ?x))) (Apply is-strong ((theme ?x)))))","note":"identical IR to par-009: proverb normalized to universal"}
{"id":"par-011","stratum":"paraphrase","pair":"par-F","text":"Обещал — выполняй.","sexpr":"(Modal Obligatory (Forall ?x (Implies (Apply promised ((theme ?x))) (Apply fulfilled ((theme ?x))))))","note":"imperative as deontic universal"}
{"id":"par-012","stratum":"paraphrase","pair":"par-F","text":"Слово надо держать.","sexpr":"(Modal Obligatory (Forall ?x (Implies (Apply promised ((theme ?x))) (Apply fulfilled ((theme ?x))))))","note":"identical IR to par-011"}
{"id":"par-013","stratum":"paraphrase","pair":"par-G","text":"Думай, прежде чем действовать.","sexpr":"(Implies (Apply acts ((agent (Concept anyone)))) (AtTime earlier (Apply thinks ((agent (Concept anyone))))))","note":"temporal precedence as implication"}
{"id":"par-014","stratum":"paraphrase","pair":"par-G","text":"Сначала мысль, потом действие.","sexpr":"(Implies (Apply acts ((agent (Concept anyone)))) (AtTime earlier (Apply thinks ((agent (Concept anyone))))))","note":"identical IR to par-013"}
{"id":"par-015","stratum":"paraphrase","pair":null,"text":"Смысл — в действии, а не в словах.","sexpr":"(And (Apply located-in ((theme (Concept meaning)) (place (Concept action)))) (Not (Apply located-in ((theme (Concept meaning)) (place (Concept words))))))","note":"contrastive location, solo (no pair)"}
